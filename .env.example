# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Server & Port for Render Keep-Alive
PORT=3000

# Bot Prefix
PREFIX=!

# Audio Configuration
DEFAULT_VOLUME=80
AUTO_LEAVE_TIMEOUT_MS=10000
COMMAND_COOLDOWN_SECONDS=5

# Optional: YouTube Cookie for Age-restricted content
YOUTUBE_COOKIE=
